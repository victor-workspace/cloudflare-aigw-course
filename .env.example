# ============================================================
# 環境變數範本（複製為 .env 並填入）
# 注意：Cloudflare Worker 不讀 .env，這只是給你記錄用。
# 實際部署請用 wrangler secret put / wrangler.toml [vars]
# ============================================================

# 你的 Cloudflare 帳號 ID（Dashboard 首頁右邊）
CF_ACCOUNT_ID=

# AI Gateway ID（在 Dashboard 建立後取得）
CF_AI_GATEWAY_ID=aigw-course

# AI Gateway Token（Dashboard → AI → AI Gateway → API Keys）
CF_AI_GATEWAY_TOKEN=

# BYOK alias 名稱（你在 AI Gateway 的 API Key Management 設定）
ANTHROPIC_BYOK_ALIAS=claude_demo

# JWT signing secret（隨機字串，至少 32 字元）
JWT_SECRET=

# MCP server 清單（id=url，逗號分隔，:oauth 後綴代表需 token）
MCP_SERVER_URLS=cloudflare-docs=https://docs.mcp.cloudflare.com,radar=https://radar.mcp.cloudflare.com

# 前端用：API base URL
VITE_API_BASE=https://aigw-course-api.YOUR-SUBDOMAIN.workers.dev
